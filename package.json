{
  "name": "nova-crowd-favorite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "deno task check && vite build && deno compile --no-check -A --include build --output dist/bin/web server.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prek run oxlint --all-files",
    "format": "treefmt",
    "organizer": "deno run --allow-env=APP_URL,SYNC_HMAC_SECRET --allow-net scripts/organizer.ts",
    "password": "secretspec get ORGANIZER_PASSWORD --provider openbao --reason 'Organizer dashboard sign-in'",
    "restore": "deno run --allow-read --allow-write --allow-env=TMPDIR,TMP,TEMP scripts/restore-database.ts"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
